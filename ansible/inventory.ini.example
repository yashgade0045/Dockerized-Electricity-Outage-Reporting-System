# ============================================================
# Ansible Inventory Example
# Copy this file to inventory.ini and fill in real values.
# ============================================================

[deployment_targets]
# Replace with your server's IP address or hostname
192.168.1.100 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa

# Example for multiple servers:
# 192.168.1.101 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa
# 192.168.1.102 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa

[all:vars]
# Application configuration
app_name=electricity-outage-reporting
app_port=8080
docker_image=yashgade0045/electricity-outage-reporting
docker_image_tag=latest
app_data_dir=/opt/outage-app/data

# Docker Hub credentials — use Ansible Vault for production secrets
# ansible-vault encrypt_string 'your_password' --name 'dockerhub_password'
dockerhub_username=yashgade0045
# dockerhub_password=  (set via --extra-vars or Ansible Vault)
